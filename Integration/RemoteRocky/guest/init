#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export DISPLAY=:0
export XDG_RUNTIME_DIR=/tmp/runtime-root

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/pts /dev/shm /dev/virtio-ports /run/dbus /run/spice-vdagentd
mkdir -p "${XDG_RUNTIME_DIR}" /tmp/.X11-unix
chmod 0700 "${XDG_RUNTIME_DIR}"
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
boot_epoch=unknown
IFS= read -r boot_epoch < /proc/sys/kernel/random/boot_id || boot_epoch=unknown

modprobe virtio_console
modprobe virtio_gpu
modprobe virtio_input
modprobe uinput
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s

dbus-uuidgen --ensure=/etc/machine-id
dbus-daemon --system --fork --nopidfile

attempt=0
while ! test -e /dev/virtio-ports/com.redhat.spice.0 \
    || ! test -e /dev/virtio-ports/org.swiftspice.perf.control; do
    mdev -s
    attempt=$((attempt + 1))
    if test "${attempt}" -ge 30; then
        echo "PERF_ERROR virtio ports unavailable"
        exec sh
    fi
    sleep 1
done

spice-vdagentd --foreground --debug --one-session &
Xorg :0 -ac -noreset -nolisten tcp -logfile /tmp/Xorg.0.log \
    -config /etc/X11/xorg.conf &

attempt=0
while ! test -S /tmp/.X11-unix/X0; do
    attempt=$((attempt + 1))
    if test "${attempt}" -ge 30; then
        echo "PERF_ERROR Xorg unavailable"
        tail -n 100 /tmp/Xorg.0.log
        exec sh
    fi
    sleep 1
done

xrandr --output Virtual-1 --mode 1280x720 --pos 0x0 --primary
openbox &
dbus-run-session -- spice-vdagent --foreground --debug &

stop_process() {
    pid_file="$1"
    if test -f "${pid_file}"; then
        pid="$(cat "${pid_file}")"
        kill -TERM -- "-${pid}" 2>/dev/null || kill "${pid}" 2>/dev/null || true
        wait "${pid}" 2>/dev/null || true
        rm -f "${pid_file}"
    fi
}

next_animation_generation() {
    generation=0
    if test -f /run/perf-animation-generation; then
        IFS= read -r generation < /run/perf-animation-generation || generation=0
        case "${generation}" in
            ''|*[!0-9]*) generation=0 ;;
        esac
    fi
    generation=$((generation + 1))
    generation_tmp="/run/perf-animation-generation.tmp.$$"
    printf '%s\n' "${generation}" > "${generation_tmp}"
    mv "${generation_tmp}" /run/perf-animation-generation
    printf '%s\n' "${generation}"
}

start_static() {
    stop_process /run/perf-animation.pid
    rm -f /run/perf-animation-generator.pid
    stop_process /run/perf-static.pid
    xsetroot -solid '#17212b'
    /usr/local/bin/static-desktop.sh &
    echo "$!" > /run/perf-static.pid
    echo "PERF_LOAD state=static"
}

start_animation() {
    stop_process /run/perf-animation.pid
    rm -f /run/perf-animation-generator.pid
    stop_process /run/perf-static.pid
    generation="$(next_animation_generation)"
    PERF_ANIMATION_GENERATION="${generation}" /usr/local/bin/animation-load.sh &
    echo "$!" > /run/perf-animation.pid
    echo "PERF_LOAD state=animation reset_frame=0 generation=${generation} method=start"
}

reset_animation() {
    if test -f /run/perf-animation.pid \
        && kill -0 "$(cat /run/perf-animation.pid)" 2>/dev/null \
        && test -f /run/perf-animation-generator.pid; then
        generator_pid="$(cat /run/perf-animation-generator.pid)"
        generation="$(next_animation_generation)"
        if kill -USR1 "${generator_pid}" 2>/dev/null; then
            echo "PERF_LOAD state=animation reset_frame=0 generation=${generation} generator_pid=${generator_pid} method=signal"
        else
            start_animation
        fi
    else
        start_animation
    fi
}

start_static
echo "PERF_READY resolution=1280x720 boot_epoch=${boot_epoch}"

while true; do
    while IFS= read -r command; do
        case "${command}" in
            start)
                start_animation
                ;;
            reset)
                reset_animation
                ;;
            stop)
                start_static
                ;;
            status)
                if test -f /run/perf-animation.pid; then
                    echo "PERF_STATUS state=animation resolution=1280x720 boot_epoch=${boot_epoch}"
                else
                    echo "PERF_STATUS state=static resolution=1280x720 boot_epoch=${boot_epoch}"
                fi
                ;;
            *)
                echo "PERF_ERROR unknown_control=${command}"
                ;;
        esac
    done < /dev/virtio-ports/org.swiftspice.perf.control
    sleep 1
done
