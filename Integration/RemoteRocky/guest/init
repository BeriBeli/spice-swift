#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export DISPLAY=:0
export XDG_RUNTIME_DIR=/tmp/runtime-root

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/pts /dev/shm /dev/virtio-ports /run/dbus /run/spice-vdagentd
mkdir -p "${XDG_RUNTIME_DIR}" /tmp/.X11-unix
chmod 0700 "${XDG_RUNTIME_DIR}"
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm

modprobe virtio_console
modprobe virtio_gpu
modprobe virtio_input
modprobe uinput
echo /sbin/mdev > /proc/sys/kernel/hotplug
# Keep mdev for the minimal early /dev population and virtio-port discovery.
# Xorg input discovery is driven by eudev's netlink database instead.
mdev -s

if ! udevd --daemon; then
    echo "PERF_ERROR eudev daemon unavailable"
    exec sh
fi
if ! udevadm trigger --action=add --type=subsystems \
    || ! udevadm trigger --action=add --type=devices \
    || ! udevadm settle --timeout=10; then
    echo "PERF_ERROR eudev device discovery failed"
    exec sh
fi

dbus-uuidgen --ensure=/etc/machine-id
dbus-daemon --system --fork --nopidfile

attempt=0
while ! test -e /dev/virtio-ports/com.redhat.spice.0 \
    || ! test -e /dev/virtio-ports/org.swiftspice.perf.control; do
    mdev -s
    attempt=$((attempt + 1))
    if test "${attempt}" -ge 30; then
        echo "PERF_ERROR virtio ports unavailable"
        exec sh
    fi
    sleep 1
done

spice-vdagentd --foreground --debug --one-session &
Xorg :0 -ac -noreset -nolisten tcp -logfile /tmp/Xorg.0.log \
    -config /etc/X11/xorg.conf &

attempt=0
while ! test -S /tmp/.X11-unix/X0; do
    attempt=$((attempt + 1))
    if test "${attempt}" -ge 30; then
        echo "PERF_ERROR Xorg unavailable"
        tail -n 100 /tmp/Xorg.0.log
        exec sh
    fi
    sleep 1
done

xrandr --output Virtual-1 --mode 1280x720 --pos 0x0 --primary
openbox &
dbus-run-session -- spice-vdagent --foreground --debug &

stop_process() {
    pid_file="$1"
    if test -f "${pid_file}"; then
        pid="$(cat "${pid_file}")"
        kill "${pid}" 2>/dev/null || true
        wait "${pid}" 2>/dev/null || true
        rm -f "${pid_file}"
    fi
}

start_static() {
    stop_process /run/perf-animation.pid
    stop_process /run/perf-static.pid
    xsetroot -solid '#17212b'
    /usr/local/bin/static-desktop.sh &
    echo "$!" > /run/perf-static.pid
    echo "PERF_LOAD state=static"
}

start_animation() {
    stop_process /run/perf-animation.pid
    stop_process /run/perf-static.pid
    /usr/local/bin/animation-load.sh &
    echo "$!" > /run/perf-animation.pid
    echo "PERF_LOAD state=animation reset_frame=0"
}

monitor_marker_inputs() {
    while true; do
        echo "PERF_MARKER_MONITOR state=starting buffering=line"
        if /usr/local/bin/input-marker-monitor.sh; then
            monitor_status=0
        else
            monitor_status=$?
        fi
        echo "PERF_ERROR input_marker_monitor=exited status=${monitor_status}"
        sleep 1
    done
}

start_static
rm -f /run/perf-marker-request /run/perf-marker-ack
mkfifo /run/perf-marker-request /run/perf-marker-ack
/usr/local/bin/input-marker-renderer.sh &
echo "$!" > /run/perf-marker-renderer.pid
monitor_marker_inputs &
echo "$!" > /run/perf-marker-monitor.pid
echo "PERF_READY resolution=1280x720"

while true; do
    while IFS= read -r command; do
        case "${command}" in
            start|reset)
                start_animation
                ;;
            stop)
                start_static
                ;;
            status)
                if test -f /run/perf-animation.pid; then
                    echo "PERF_STATUS state=animation resolution=1280x720"
                else
                    echo "PERF_STATUS state=static resolution=1280x720"
                fi
                ;;
            diagnose-input)
                /usr/local/bin/input-diagnostics.sh
                ;;
            arm\ action_class=*\ token=*)
                action_class="${command#arm action_class=}"
                action_class="${action_class%% token=*}"
                token="${command##* token=}"
                /usr/local/bin/input-marker-agent.sh arm "${action_class}" "${token}"
                ;;
            *)
                echo "PERF_ERROR unknown_control=${command}"
                ;;
        esac
    done < /dev/virtio-ports/org.swiftspice.perf.control
    sleep 1
done
