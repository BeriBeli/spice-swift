#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mkdir -p /dev/pts /dev/shm /dev/virtio-ports
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm

modprobe virtio_console
modprobe snd_hda_intel
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s

attempt=0
while ! test -e /dev/virtio-ports/org.swiftspice.audio.control \
    || ! test -e /dev/snd/pcmC0D0p \
    || ! test -e /dev/snd/pcmC0D0c; do
    mdev -s
    attempt=$((attempt + 1))
    if test "${attempt}" -ge 30; then
        echo "AUDIO_ERROR devices_unavailable"
        aplay -l 2>&1 || true
        arecord -l 2>&1 || true
        exec sh
    fi
    sleep 1
done

stop_pid() {
    pid_file="$1"
    if test -f "${pid_file}"; then
        pid="$(cat "${pid_file}")"
        kill "${pid}" 2>/dev/null || true
        wait "${pid}" 2>/dev/null || true
        rm -f "${pid_file}"
    fi
}

stop_all() {
    stop_pid /run/audio-playback.pid
    stop_pid /run/audio-record.pid
}

reset_all() {
    stop_all
    rm -f /tmp/record.raw /tmp/playback.log /tmp/record.log
    echo "AUDIO_RESET playback=idle record=idle"
}

start_playback() {
    stop_pid /run/audio-playback.pid
    (
        child=""
        trap 'test -n "${child}" && kill "${child}" 2>/dev/null || true; wait "${child}" 2>/dev/null || true; exit 143' TERM INT
        speaker-test -D hw:0,0 -t sine -f 880 -r 48000 -c 2 -l 30 \
            >/tmp/playback.log 2>&1 &
        child="$!"
        wait "${child}"
        status=$?
        bytes="$(wc -c </tmp/playback.log | tr -d ' ')"
        echo "AUDIO_PLAYBACK_COMPLETE status=${status} frequency=880 rate=48000 channels=2 log_bytes=${bytes}"
        test "${status}" -eq 0 || sed 's/^/AUDIO_PLAYBACK_LOG /' /tmp/playback.log
        rm -f /run/audio-playback.pid
    ) &
    echo "$!" > /run/audio-playback.pid
    echo "AUDIO_PLAYBACK_STARTED frequency=880 rate=48000 channels=2 loops=30"
}

start_record() {
    stop_pid /run/audio-record.pid
    rm -f /tmp/record.raw /tmp/record.log
    (
        child=""
        trap 'test -n "${child}" && kill "${child}" 2>/dev/null || true; wait "${child}" 2>/dev/null || true; exit 143' TERM INT
        arecord -D hw:0,0 -t raw -f S16_LE -r 48000 -c 2 -d 15 \
            /tmp/record.raw >/tmp/record.log 2>&1 &
        child="$!"
        wait "${child}"
        status=$?
        bytes="$(wc -c </tmp/record.raw | tr -d ' ')"
        sha256="$(sha256sum /tmp/record.raw | cut -d ' ' -f 1)"
        echo "AUDIO_RECORD_COMPLETE status=${status} rate=48000 channels=2 bytes=${bytes} sha256=${sha256}"
        test "${status}" -eq 0 || sed 's/^/AUDIO_RECORD_LOG /' /tmp/record.log
        rm -f /run/audio-record.pid
    ) &
    echo "$!" > /run/audio-record.pid
    echo "AUDIO_RECORD_STARTED rate=48000 channels=2 seconds=15"
}

show_status() {
    playback=idle
    record=idle
    test -f /run/audio-playback.pid && playback=running
    test -f /run/audio-record.pid && record=running
    echo "AUDIO_STATUS playback=${playback} record=${record}"
    if test -f /tmp/record.raw; then
        bytes="$(wc -c </tmp/record.raw | tr -d ' ')"
        echo "AUDIO_RECORD_BYTES bytes=${bytes}"
    fi
}

echo "AUDIO_DEVICES_BEGIN"
aplay -l
arecord -l
echo "AUDIO_DEVICES_END"
echo "AUDIO_MIXER_BEGIN"
amixer -c 0 scontrols
amixer -c 0 sset Master 100% unmute || true
amixer -c 0 sset PCM 100% unmute || true
amixer -c 0 sget Master || true
echo "AUDIO_MIXER_END"
reset_all
echo "AUDIO_READY playback=hw:0,0 record=hw:0,0 rate=48000 channels=2"

while true; do
    while IFS= read -r command; do
        case "${command}" in
            playback-start) start_playback ;;
            record-start) start_record ;;
            reset) reset_all ;;
            stop) stop_all; echo "AUDIO_STOPPED playback=idle record=idle" ;;
            status) show_status ;;
            *) echo "AUDIO_ERROR unknown_control=${command}" ;;
        esac
    done < /dev/virtio-ports/org.swiftspice.audio.control
    sleep 1
done
