FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cpio \
        gzip \
        kmod \
        qemu-system-modules-spice \
        qemu-system-x86 \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*
